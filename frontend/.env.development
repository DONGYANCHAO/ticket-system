# ==========================================
# 开发环境配置
# 适用于本地开发调试
# ==========================================

# 环境标识
NODE_ENV=development

# API 基础地址（开发环境使用本地后端）
VITE_API_BASE_URL=http://localhost:8080/api

# 上传文件基础地址
VITE_UPLOAD_BASE_URL=http://localhost:8080/api/file

# 静态资源基础地址
VITE_STATIC_BASE_URL=http://localhost:8080

# 应用标题
VITE_APP_TITLE=工单系统(开发版)

# 应用版本
VITE_APP_VERSION=1.0.0-dev

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 是否启用调试工具
VITE_ENABLE_DEBUG=true

# 是否显示 API 文档链接
VITE_SHOW_API_DOCS=true

# API 文档地址
VITE_API_DOCS_URL=http://localhost:8080/api/swagger-ui.html

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=30000

# 是否启用操作日志
VITE_ENABLE_OPERATION_LOG=true

# 日志级别（debug, info, warn, error）
VITE_LOG_LEVEL=debug

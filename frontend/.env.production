# ==========================================
# 生产环境配置
# 适用于正式生产部署
# ==========================================

# 环境标识
NODE_ENV=production

# API 基础地址（生产环境使用相对路径，通过 Nginx 代理）
VITE_API_BASE_URL=/api

# 上传文件基础地址
VITE_UPLOAD_BASE_URL=/api/file

# 静态资源基础地址（使用相对路径）
VITE_STATIC_BASE_URL=

# 应用标题
VITE_APP_TITLE=工单系统

# 应用版本
VITE_APP_VERSION=1.0.0

# 是否启用 Mock 数据（生产环境禁用）
VITE_USE_MOCK=false

# 是否启用调试工具（生产环境禁用）
VITE_ENABLE_DEBUG=false

# 是否显示 API 文档链接（生产环境禁用）
VITE_SHOW_API_DOCS=false

# API 文档地址
VITE_API_DOCS_URL=

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=30000

# 是否启用操作日志
VITE_ENABLE_OPERATION_LOG=false

# 日志级别（debug, info, warn, error）
VITE_LOG_LEVEL=error

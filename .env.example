# ==========================================
# 工单系统环境变量配置示例
# 复制为 .env 文件并根据实际情况修改
# ==========================================

# ---------------- 数据库配置 ----------------
MYSQL_ROOT_PASSWORD=Ticket@123
MYSQL_USER=ticket
MYSQL_PASSWORD=Ticket@123
MYSQL_PORT=3306

# ---------------- Redis 配置 ----------------
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------- 后端服务配置 ----------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=your-256-bit-secret-key-change-in-production
LOG_LEVEL=INFO

# ---------------- 前端服务配置 ----------------
FRONTEND_PORT=80

# ---------------- 钉钉通知配置（可选）----------------
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ---------------- 邮件配置（可选）----------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
